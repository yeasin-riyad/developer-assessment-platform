{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "types": ["node"],

    "sourceMap": true
  },

  "include": [
    "src/**/*.ts",
    "prisma7.config.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}