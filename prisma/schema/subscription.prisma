model Subscription {
  id          String             @id @default(uuid())
  candidateId String
  plan        SubscriptionPlan
  status      SubscriptionStatus @default(PENDING)

  startDate   DateTime? 
  endDate     DateTime?

  candidate   User  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  payments    SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refundAmount Decimal? @db.Decimal(10, 2)

  @@index([candidateId])
  @@index([status])
  @@index([endDate])
}



model SubscriptionPayment {
  id                    String   @id @default(uuid())
  subscriptionId        String
  merchantInvoiceNumber String   @unique

  amount                Decimal  @db.Decimal(10, 2)
  status                SubscriptionPaymentStatus @default(PENDING)

  // Existing fields can remain
  bkashPaymentId        String?  @unique
  bkashTrxId            String?
  payerReference        String?

  // SSLCOMMERZ fields
  sslcommerzSessionKey  String?  @unique
  sslcommerzValId       String?  @unique

  gatewayResponse       Json?
  paidAt                DateTime?
  refundedAt            DateTime?
  refundTrxId           String?
  refundAmount          Decimal? @db.Decimal(10, 2)
  refundReason          String?

  subscription Subscription @relation(fields: [subscriptionId],references: [id],onDelete: Cascade)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([subscriptionId])
  @@index([status])
}