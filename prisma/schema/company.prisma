model Company {
  id          String   @id @default(uuid())
  name        String
  description String?
  website     String?
  logo        String?
  status      CompanyStatus @default(ACTIVE)

  recruiterId String   @unique
  recruiter   User     @relation(fields: [recruiterId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}