model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(CANDIDATE)
  company   Company?

  problems  Problem[]
  assessments Assessment[]
  invitations Invitation[]
  attempts Attempt[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}